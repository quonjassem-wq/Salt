{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/gen/hide/test", "destination": "/gen/hide/test/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
